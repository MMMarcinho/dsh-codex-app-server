{
  "name": "dsh-codex-app-server",
  "version": "0.1.0",
  "description": "Add a Codex app-server session preset to DeepSeek Harness",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MMMarcinho/dsh-codex-app-server.git"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.5"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "src",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm pack --dry-run",
    "test:host": "node tests/host-smoke.mjs"
  }
}
